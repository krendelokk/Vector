# --- База даних ---
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal

# --- JWT (обов'язково замініть у продакшні: openssl rand -hex 48) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# true лише коли сайт працює через HTTPS
COOKIE_SECURE=false

# --- Сервер ---
PORT=3000
NODE_ENV=development
TZ=Europe/Kyiv

# --- Файли ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- Integrity Index ---
# Мінімальна кількість респондентів, щоб підсумки можна було опублікувати (захист анонімності)
MIN_RESPONDENTS_TO_PUBLISH=5

# --- Telegram-бот (необов'язково; порожній токен вимикає бота) ---
TELEGRAM_BOT_TOKEN=
# webhook (потрібна публічна HTTPS-адреса) або polling (для внутрішньої мережі)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://portal.example.edu.ua/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# --- Sentry (необов'язково) ---
SENTRY_DSN=

# --- Ліміти запитів ---
# Невдалих спроб входу до блокування облікового запису на 15 хв
MAX_FAILED_LOGINS=5
# Ліміти за IP-адресою на хвилину. Високі, бо за NAT університету в усіх одна адреса
LOGIN_RATE_LIMIT=60
TRUSTBOX_RATE_LIMIT=5
API_RATE_LIMIT=3000
