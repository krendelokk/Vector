# Скопіюйте цей файл у .env і заповніть значення.
# Згенерувати секрет: openssl rand -hex 48   (у Windows: Git Bash або PowerShell, див. README)

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=7
MIN_RESPONDENTS_TO_PUBLISH=5

# Telegram-бот (необов'язково). polling працює у внутрішній мережі; webhook потребує публічного HTTPS
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Sentry (необов'язково)
SENTRY_DSN=
